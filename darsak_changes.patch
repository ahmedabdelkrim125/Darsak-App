diff --git a/lib/core/notifications/lesson_reminder_service.dart b/lib/core/notifications/lesson_reminder_service.dart
new file mode 100644
index 0000000..bfa29da
--- /dev/null
+++ b/lib/core/notifications/lesson_reminder_service.dart
@@ -0,0 +1,114 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:timezone/timezone.dart' as tz;
+import '../../feat/classroom/data/classroom_store.dart';
+import '../helper/time_formatter.dart';
+import '../session/app_session.dart';
+import '../settings/app_settings.dart';
+import 'notification_service.dart';
+
+class LessonReminderService {
+  LessonReminderService._();
+
+  static final LessonReminderService instance = LessonReminderService._();
+
+  Timer? _debounce;
+  bool _listening = false;
+  bool _running = false;
+  bool _again = false;
+
+  void start() {
+    if (!_listening) {
+      ClassroomStore.instance.addListener(_request);
+      AppSettings.instance.addListener(_request);
+      _listening = true;
+    }
+    _request();
+  }
+
+  Future<void> stop() async {
+    if (_listening) {
+      ClassroomStore.instance.removeListener(_request);
+      AppSettings.instance.removeListener(_request);
+      _listening = false;
+    }
+    _debounce?.cancel();
+    _debounce = null;
+    await NotificationService.instance.cancelAll();
+  }
+
+  void _request() {
+    _debounce?.cancel();
+    _debounce = Timer(const Duration(milliseconds: 700), () {
+      unawaited(_apply());
+    });
+  }
+
+  Future<void> _apply() async {
+    if (_running) {
+      _again = true;
+      return;
+    }
+    _running = true;
+    try {
+      final service = NotificationService.instance;
+      await service.cancelLessonReminders();
+      final settings = AppSettings.instance;
+      if (!settings.notifyLessons || !AppSession.instance.isSignedIn) return;
+
+      final store = ClassroomStore.instance;
+      final minutes = settings.reminderMinutes;
+      final now = tz.TZDateTime.now(tz.local);
+      var id = 1;
+      for (var weekday = DateTime.monday; weekday <= DateTime.sunday; weekday++) {
+        for (final lesson in store.lessonsOn(weekday)) {
+          final group = store.groupById(lesson.groupId);
+          if (group == null) continue;
+          await service.scheduleWeekly(
+            id: id++,
+            title: 'حصتك بعد ${_label(minutes)}',
+            body:
+                '${lesson.subject} - ${group.name} الساعة ${formatTime(lesson.time)}',
+            firstFire: _nextFire(now, weekday, lesson.time, minutes),
+            payload: '${NotificationService.lessonPayloadPrefix}${lesson.id}',
+          );
+        }
+      }
+    } finally {
+      _running = false;
+      if (_again) {
+        _again = false;
+        _request();
+      }
+    }
+  }
+
+  tz.TZDateTime _nextFire(
+    tz.TZDateTime now,
+    int weekday,
+    TimeOfDay time,
+    int minutes,
+  ) {
+    for (var offset = 0; offset <= 7; offset++) {
+      final day = now.add(Duration(days: offset));
+      if (day.weekday != weekday) continue;
+      final start = tz.TZDateTime(
+        tz.local,
+        day.year,
+        day.month,
+        day.day,
+        time.hour,
+        time.minute,
+      );
+      final fire = start.subtract(Duration(minutes: minutes));
+      if (fire.isAfter(now)) return fire;
+    }
+    return now.add(const Duration(days: 7));
+  }
+
+  String _label(int minutes) {
+    if (minutes == 60) return 'ساعة';
+    if (minutes <= 10) return '$minutes دقائق';
+    return '$minutes دقيقة';
+  }
+}
diff --git a/lib/core/notifications/notification_service.dart b/lib/core/notifications/notification_service.dart
new file mode 100644
index 0000000..a9194d7
--- /dev/null
+++ b/lib/core/notifications/notification_service.dart
@@ -0,0 +1,185 @@
+import 'dart:async';
+import 'package:flutter/foundation.dart';
+import 'package:flutter_local_notifications/flutter_local_notifications.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:timezone/data/latest.dart' as tz_data;
+import 'package:timezone/timezone.dart' as tz;
+import '../routing/app_navigator.dart';
+import '../routing/routes.dart';
+import '../session/app_session.dart';
+
+class NotificationService {
+  NotificationService._();
+
+  static final NotificationService instance = NotificationService._();
+
+  static const String lessonPayloadPrefix = 'lesson:';
+
+  static const String _channelId = 'darsak_alerts_v1';
+  static const String _channelName = 'تنبيهات درسّك';
+  static const String _channelDescription =
+      'تنبيهات الحصص والمدفوعات والمجموعات';
+  static const String _soundName = 'darsak_notification';
+  static const String _statIcon = 'ic_stat_notification';
+  static const String _exactAskedKey = 'notifications.exact_alarm_asked';
+
+  final FlutterLocalNotificationsPlugin _plugin =
+      FlutterLocalNotificationsPlugin();
+
+  bool _ready = false;
+  int _immediateCounter = 0;
+
+  AndroidFlutterLocalNotificationsPlugin? get _android {
+    return _plugin
+        .resolvePlatformSpecificImplementation<
+          AndroidFlutterLocalNotificationsPlugin
+        >();
+  }
+
+  Future<void> init() async {
+    if (_ready) return;
+    try {
+      tz_data.initializeTimeZones();
+      tz.setLocalLocation(tz.getLocation('Africa/Cairo'));
+      await _plugin.initialize(
+        const InitializationSettings(
+          android: AndroidInitializationSettings(_statIcon),
+          iOS: DarwinInitializationSettings(
+            requestAlertPermission: false,
+            requestBadgePermission: false,
+            requestSoundPermission: false,
+          ),
+        ),
+        onDidReceiveNotificationResponse: (_) => _openInbox(),
+      );
+      await _android?.createNotificationChannel(
+        const AndroidNotificationChannel(
+          _channelId,
+          _channelName,
+          description: _channelDescription,
+          importance: Importance.high,
+          playSound: true,
+          sound: RawResourceAndroidNotificationSound(_soundName),
+          enableVibration: true,
+        ),
+      );
+      _ready = true;
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] init: $error');
+    }
+  }
+
+  Future<void> requestPermissions() async {
+    if (!_ready) return;
+    try {
+      await _android?.requestNotificationsPermission();
+      await _plugin
+          .resolvePlatformSpecificImplementation<
+            IOSFlutterLocalNotificationsPlugin
+          >()
+          ?.requestPermissions(alert: true, badge: true, sound: true);
+      await _askExactAlarmOnce();
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] permissions: $error');
+    }
+  }
+
+  Future<void> _askExactAlarmOnce() async {
+    final android = _android;
+    if (android == null) return;
+    final can = await android.canScheduleExactNotifications() ?? true;
+    if (can) return;
+    final prefs = await SharedPreferences.getInstance();
+    if (prefs.getBool(_exactAskedKey) ?? false) return;
+    await prefs.setBool(_exactAskedKey, true);
+    await android.requestExactAlarmsPermission();
+  }
+
+  NotificationDetails _details(String body) {
+    return NotificationDetails(
+      android: AndroidNotificationDetails(
+        _channelId,
+        _channelName,
+        channelDescription: _channelDescription,
+        importance: Importance.high,
+        priority: Priority.high,
+        playSound: true,
+        sound: const RawResourceAndroidNotificationSound(_soundName),
+        enableVibration: true,
+        icon: _statIcon,
+        styleInformation: BigTextStyleInformation(body),
+      ),
+      iOS: const DarwinNotificationDetails(
+        presentAlert: true,
+        presentBadge: true,
+        presentSound: true,
+      ),
+    );
+  }
+
+  Future<void> show({required String title, required String body}) async {
+    if (!_ready) return;
+    try {
+      _immediateCounter++;
+      final id = 1000000 + (_immediateCounter % 1000000);
+      await _plugin.show(id, title, body, _details(body));
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] show: $error');
+    }
+  }
+
+  Future<void> scheduleWeekly({
+    required int id,
+    required String title,
+    required String body,
+    required tz.TZDateTime firstFire,
+    required String payload,
+  }) async {
+    if (!_ready) return;
+    try {
+      final exact = await _android?.canScheduleExactNotifications() ?? false;
+      await _plugin.zonedSchedule(
+        id,
+        title,
+        body,
+        firstFire,
+        _details(body),
+        androidScheduleMode: exact
+            ? AndroidScheduleMode.exactAllowWhileIdle
+            : AndroidScheduleMode.inexactAllowWhileIdle,
+        matchDateTimeComponents: DateTimeComponents.dayOfWeekAndTime,
+        payload: payload,
+      );
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] schedule: $error');
+    }
+  }
+
+  Future<void> cancelLessonReminders() async {
+    if (!_ready) return;
+    try {
+      final pending = await _plugin.pendingNotificationRequests();
+      for (final request in pending) {
+        if (request.payload?.startsWith(lessonPayloadPrefix) ?? false) {
+          await _plugin.cancel(request.id);
+        }
+      }
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] cancel: $error');
+    }
+  }
+
+  Future<void> cancelAll() async {
+    if (!_ready) return;
+    try {
+      await _plugin.cancelAll();
+    } on Object catch (error) {
+      if (kDebugMode) debugPrint('[Notifications] cancelAll: $error');
+    }
+  }
+
+  void _openInbox() {
+    if (!AppSession.instance.isSignedIn) return;
+    AppNavigator.key.currentState?.pushNamed(Routes.notifications);
+  }
+}
